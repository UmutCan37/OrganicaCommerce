@model OrganicaCommerce.Contracts.Cart.CartResponse

@{
    ViewData["Title"] = "Sepetim";
}

<!-- Breadcrumb section start -->
<section class="breadcrumb_sec_1 position-relative">
    <div class="breadcrumb_wrap sec_space_mid_small"
         style="background-image: url(/organic-html/assets/images/breadcrumb/breadcrumb1.png);">
        <div class="breadcrumb_cont text-center">
            <div class="breadcrumb_title">
                <h2 class="text-white">Sepetim</h2>
            </div>
            <ul class="list-unstyled breadcrumb_item d-flex justify-content-center align-items-center text-white">
                <li><a asp-controller="Home" asp-action="Index"><i class="fas fa-home active"></i>Ana Sayfa</a></li>
                <li><i class="fas fa-chevron-right"></i>Sepetim</li>
            </ul>
        </div>
    </div>
</section>
<!-- Breadcrumb section end -->
<!-- cart_section - start -->
<section class="cart_section sec_space_large">
    <div class="container">
        @if (Model is null || !Model.Items.Any())
        {
            <div class="text-center py-5">
                <p class="text-muted mb-3">Sepetiniz boş.</p>
                <a asp-controller="Shop" asp-action="List" class="btn custom_btn rounded-pill text-white">
                    Alışverişe Devam Et <i class="fas fa-long-arrow-alt-right"></i>
                </a>
            </div>
        }
        else
        {
            <div class="cart_table table-responsive position-relative">
                <table class="table align-middle">
                    <thead class="text-uppercase">
                        <tr>
                            <th>Görsel</th>
                            <th>Ürün Adı</th>
                            <th>Fiyat</th>
                            <th>Adet</th>
                            <th>Toplam</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="cart_product position-relative">
                                        <div class="item_image">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/organic-html/assets/images/product/product1.png" : item.ImageUrl)"
                                                 alt="@item.ProductName">
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="item_content">
                                        <h4 class="item_title">@item.ProductName</h4>
                                    </div>
                                </td>
                                <td>
                                    <span class="price_text">@item.UnitPrice.ToString("C")</span>
                                </td>
                                <td>
                                    <span class="price_text">@item.Quantity</span>
                                </td>
                                <td>
                                    <span class="total_price">@item.LineTotal.ToString("C")</span>
                                </td>
                                <td>
                                    <form asp-action="RemoveFromCart" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="remove_btn border-0 bg-transparent">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-lg-end">
                <div class="col col-lg-4 mt-5">
                    <div class="cart_pricing_table text-uppercase">
                        <h3 class="table_title text-center">Sepet Toplamı</h3>
                        <ul class="ul_li_block clearfix">
                            <li><span>Ara Toplam</span> <span>@Model.Total.ToString("C")</span></li>
                            <li><span>Toplam</span> <span>@Model.Total.ToString("C")</span></li>
                        </ul>
                        <div class="btn_wrap pt-0 text-center">
                            <button type="button" id="checkoutBtn" class="btn text-uppercase text-white rounded-pill border-0">
                                Siparişi Tamamla
                            </button>
                        </div>
                        <div id="checkoutMessage" class="text-center mt-2"></div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
<!-- cart_section - end -->
@section Scripts {
    <script>
        document.getElementById('checkoutBtn')?.addEventListener('click', async function () {
            const messageDiv = document.getElementById('checkoutMessage');
            try {
                const response = await fetch('/Orders/Create', { method: 'POST' });
                if (response.ok) {
                    const result = await response.json();
                    window.location.href = '/Orders/Confirmation/' + result.orderId;
                } else {
                    messageDiv.innerHTML = '<span class="text-danger">Sipariş oluşturulamadı. Stok yetersiz olabilir.</span>';
                }
            } catch {
                messageDiv.innerHTML = '<span class="text-danger">Bağlantı hatası.</span>';
            }
        });
    </script>
}
@model List<OrganicaCommerce.Contracts.Products.ProductListItemResponse>

@{
    ViewData["Title"] = "Ürünler";
    var categories = ViewBag.Categories as List<OrganicaCommerce.Contracts.Categories.CategoryResponse>;
    Guid? selectedCategoryId = ViewBag.SelectedCategoryId;
}

<!-- Breadcrumb section start -->
<section class="breadcrumb_sec_1 position-relative">
    <div class="breadcrumb_wrap sec_space_mid_small"
         style="background-image: url(/organic-html/assets/images/breadcrumb/breadcrumb1.png);">
        <div class="breadcrumb_cont text-center">
            <div class="breadcrumb_title">
                <h2 class="text-white">Ürünlerimiz</h2>
            </div>
            <ul class="list-unstyled breadcrumb_item d-flex justify-content-center align-items-center text-white">
                <li><a asp-controller="Home" asp-action="Index"><i class="fas fa-home active"></i>Ana Sayfa</a></li>
                <li><i class="fas fa-chevron-right"></i>Ürünler</li>
            </ul>
        </div>
    </div>
</section>
<!-- Breadcrumb section end -->
<!-- shop list sidebar start -->
<section class="shop_list_sidebar sec_space_large">
    <div class="shop_sidebar_wrap">
        <div class="container">
            <div class="row">
                <div class="col-lg-3">
                    <!-- category filter start -->
                    <div class="blog_category" data-aos="fade-up" data-aos-duration="2000">
                        <div class="blog_category_wrap">
                            <h3 class="blog_category_title py-3">Kategoriler</h3>
                            <div class="blog_category_item">
                                <div class="row">
                                    <div class="form-check">
                                        <div class="col">
                                            <a asp-controller="Shop" asp-action="List"
                                               class="text-decoration-none @(selectedCategoryId == null ? "fw-bold" : "")">
                                                Tüm Ürünler
                                            </a>
                                        </div>
                                        @if (categories is not null)
                                        {
                                            foreach (var category in categories)
                                            {
                                                <div class="col pt-2">
                                                    <a asp-controller="Shop" asp-action="List" asp-route-categoryId="@category.Id"
                                                       class="text-decoration-none @(selectedCategoryId == category.Id ? "fw-bold" : "")">
                                                        @category.Name
                                                    </a>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- category filter end -->
                </div>

                <div class="col-lg-9">
                    <!-- shop list section start -->
                    <section class="shop_list_section">
                        <div class="filter_area d-flex justify-content-between align-items-center mb_30">
                            <span class="show_result">@(Model?.Count ?? 0) ürün bulundu</span>
                        </div>
                        <div class="shop_product_list">
                            <div class="row g-4">
                                @if (Model is not null && Model.Any())
                                {
                                    foreach (var product in Model)
                                    {
                                        <div class="col-sm-6 col-lg-4">
                                            <div class="product_layout_1 overflow-hidden position-relative">
                                                <div class="product_layout_content bg-white position-relative">
                                                    <div class="product_image_wrap">
                                                        <a class="product_image d-flex justify-content-center align-items-center"
                                                           asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id">
                                                            <img class="pic-1"
                                                                 src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/organic-html/assets/images/product/product1.png" : product.ImageUrl)"
                                                                 alt="@product.Name">
                                                        </a>
                                                        <ul class="product_badge_group ul_li_block">
                                                            <li>
                                                                <span class="product_badge badge_meats position-absolute rounded-pill text-uppercase">
                                                                    @product.CategoryName
                                                                </span>
                                                            </li>
                                                            @if (product.Stock <= 0)
                                                            {
                                                                <li>
                                                                    <span class="product_badge badge_discount position-absolute rounded-pill">
                                                                        Stokta Yok
                                                                    </span>
                                                                </li>
                                                            }
                                                        </ul>
                                                        <ul class="product_action_btns ul_li_block d-flex">
                                                            <li>
                                                                <a class="tooltips" data-placement="top" title="Ürünü Gör"
                                                                   asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id">
                                                                    <i class="fas fa-search"></i>
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                    <div class="product_content">
                                                        <h3 class="product_title">
                                                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id">
                                                                @product.Name
                                                            </a>
                                                        </h3>
                                                        <div class="product_price">
                                                            <span class="sale_price pe-1">@product.Price.ToString("C")</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-center text-muted">Bu kategoride ürün bulunmuyor.</p>
                                }
                            </div>
                        </div>
                    </section>
                    <!-- shop list section end -->
                </div>
            </div>
        </div>
    </div>
</section>
<!-- shop list sidebar end -->
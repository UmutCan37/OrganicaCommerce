@model OrganicaCommerce.Contracts.Products.CreateProductRequest

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Ürün";
    var categories = ViewBag.Categories as List<OrganicaCommerce.Contracts.Categories.CategoryResponse>;
}

<div class="admin_card" style="max-width: 640px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Ürün Adı</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Açıklama</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Fiyat (₺)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Stok</label>
                <input asp-for="Stock" type="number" class="form-control" required />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Görsel URL</label>
            <input asp-for="ImageUrl" class="form-control" placeholder="/organic-html/assets/images/product/product1.png" />
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Kategori</label>
            <select asp-for="CategoryId" class="form-select" required>
                <option value="">Kategori seçin</option>
                @if (categories is not null)
                {
                    foreach (var category in categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                }
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-brand">Ürünü Kaydet</button>
            <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </div>
    </form>
</div>
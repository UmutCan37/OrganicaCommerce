@model List<OrganicaCommerce.Contracts.Products.ProductListItemResponse>

@{
    ViewData["Title"] = "Ana Sayfa";
    var categories = ViewBag.Categories as List<OrganicaCommerce.Contracts.Categories.CategoryResponse>;
}

<!-- banner section start -->
<section class="banner_section_main position-relative banner_2">
    <div class="banner_section_item d-flex justify-content-center align-items-center sec_space_large"
         style="background-image: url(/organic-html/assets/images/banner/banner2.png);">
        <div class="container">
            <div class="row">
                <div class="col-lg-7 ms-3">
                    <div class="banner_sub_title2 position-relative">
                        <h6 class="text-white text-uppercase position-absolute">%100 Organik Gıda</h6>
                        <img class="sub_title_bg" src="/organic-html/assets/images/shapes/shape2.png" alt="">
                    </div>
                    <div class="banner_title2">
                        <h1>
                            Taze ve Organik Ürünler<font class="text-effect">
                                <span>S</span><span>a</span><span>ğ</span><span>l</span><span>ı</span><span>k</span><span>l</span><span>ı</span>
                            </font>
                        </h1>
                    </div>
                    <div class="banner_desc py-3">
                        <p>Doğadan sofranıza, güvenilir ve organik lezzetler. En taze ürünler kapınızda.</p>
                    </div>
                    <div class="banner_btn">
                        <a asp-controller="Shop" asp-action="List">
                            <button type="button" class="btn custom_btn rounded-pill px-5 py-3 text-white">
                                Alışverişe Başla <i class="fas fa-long-arrow-alt-right"></i>
                            </button>
                        </a>
                    </div>
                </div>
                <div class="col-lg-5"></div>
            </div>
        </div>
    </div>
    <img class="banner2_right_thumb position-absolute" src="/organic-html/assets/images/shapes/shape5.png" alt="">
</section>
<!-- banner section end -->
<!-- category section start -->
@if (categories is not null && categories.Any())
{
    <section class="sec_space_xms_60">
        <div class="container">
            <div class="team_top_content text-center pb-4">
                <div class="product_top_title text-center py-1">
                    <h2>Kategoriler</h2>
                </div>
            </div>
            <div class="row g-3 justify-content-center">
                @foreach (var category in categories)
                {
                    var emoji = category.Name switch
                    {
                        "Sebzeler" => "🥦",
                        "Meyveler" => "🍎",
                        "Bakliyat" => "🌾",
                        "Süt Ürünleri" => "🥛",
                        "Kuruyemiş" => "🌰",
                        "Baharatlar" => "🌿",
                        _ => "🛒"
                    };

                    <div class="col-4 col-sm-3 col-md-2">
                        <a asp-controller="Shop" asp-action="List" asp-route-categoryId="@category.Id"
                           class="text-decoration-none">
                            <div class="service_inner_content d-flex justify-content-center align-items-center flex-column text-center p-3 shadow-sm bg-white rounded h-100">
                                <span style="font-size: 2rem;" class="mb-2">@emoji</span>
                                <h6 class="mb-0 text-dark">@category.Name</h6>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}
<!-- category section end -->
<!-- product section start -->
<section class="product_section3 sec_space_xms_60">
    <div class="product_section3_wrap inner_p_all_40 position-relative">
        <div class="container">
            <div class="product_sec_content_wrap position-relative overflow-hidden shadow inner_p_all_100 bg-white">
                <div class="team_top_content text-center">
                    <div class="offer_sub_title d-flex align-items-center justify-content-center pb-2">
                        <i class="far fa-circle"></i><i class="far fa-circle"></i><i class="far fa-circle"></i>
                        <span class="text-uppercase px-3">ÇİFTLİĞİMİZDEN TAZE</span>
                        <i class="far fa-circle"></i><i class="far fa-circle"></i><i class="far fa-circle"></i>
                    </div>
                    <div class="product_top_title text-center py-1">
                        <h2>Öne Çıkan Ürünler</h2>
                    </div>
                </div>

                <div class="row g-4 pt-4">
                    @if (Model is not null && Model.Any())
                    {
                        foreach (var product in Model.Take(8))
                        {
                            <div class="col-sm-6 col-lg-3">
                                <div class="product_layout_1 overflow-hidden position-relative">
                                    <div class="product_layout_content bg-white position-relative">
                                        <div class="product_image_wrap">
                                            <a class="product_image d-flex justify-content-center align-items-center"
                                               asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id">
                                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/organic-html/assets/images/product/product1.png" : product.ImageUrl)"
                                                     alt="@product.Name">
                                            </a>
                                            <ul class="product_badge_group ul_li_block">
                                                <li>
                                                    <span class="product_badge badge_meats position-absolute rounded-pill text-uppercase">
                                                        @product.CategoryName
                                                    </span>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="product_content">
                                            <h3 class="product_title">
                                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id">
                                                    @product.Name
                                                </a>
                                            </h3>
                                            <div class="product_price">
                                                <span class="sale_price pe-1">@product.Price.ToString("C")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-center text-muted">Henüz ürün bulunmuyor.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- product section end -->
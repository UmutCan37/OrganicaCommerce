<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - OrganicaCommerce</title>
    <link rel="shortcut icon" href="~/organic-html/assets/images/icons/favicon.ico" type="image/x-icon">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Roboto:wght@400;500;700;900&family=Merriweather:ital,wght@0,400;0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/organic-html/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/organic-html/assets/css/aos.css">
    <link rel="stylesheet" href="~/organic-html/assets/css/magnific-popup.css">
    <link rel="stylesheet" href="~/organic-html/assets/css/nice-select.css">
    <link rel="stylesheet" href="~/organic-html/assets/css/slick-theme.css">
    <link rel="stylesheet" href="~/organic-html/assets/css/slick.css">
    <link rel="stylesheet" href="~/organic-html/assets/css/style.css">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="body-wrap overflow-hidden">
        <div class="backtotop">
            <a href="#!" class="scroll"><i class="far fa-arrow-up fw-bold"></i></a>
        </div>

        <!-- header section start -->
        <header class="header_section position-relative header_2">
            <div class="header_bottom_main">
                <div class="container">
                    <nav class="navbar navbar-expand-lg navbar-light">
                        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                            <img src="~/organic-html/assets/images/logo/logo.png" alt="OrganicaCommerce">
                        </a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="navbarSupportedContent">
                            <ul class="navbar-nav main_menu_list m-auto">
                                <li class="nav-item px-2">
                                    <a class="nav-link" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                                </li>
                                <li class="nav-item px-2">
                                    <a class="nav-link" asp-controller="Shop" asp-action="List">Ürünler</a>
                                </li>
                                <li class="nav-item px-2">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Admin Panel</a>
                                </li>
                            </ul>
                        </div>
                        <div class="navbar_user me-2">
                            <ul class="list-unstyled d-flex mb-0">
                                <li>
                                    <a asp-controller="Cart" asp-action="Index">
                                        <i class="fas fa-shopping-bag position-relative">
                                            @await Component.InvokeAsync("CartSummary")
                                        </i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </nav>
                </div>
            </div>
        </header>
        <!-- header section end -->
        @RenderBody()

        <!-- footer section start -->
        <footer class="footer_section position-relative">
            <div class="footer_section_wrap sec_top_space_50" style="background-image: url(/organic-html/assets/images/footer/footer.png)">
                <div class="container">
                    <div class="footer_top_content d-flex flex-column flex-lg-row justify-content-between align-items-center">
                        <div class="footer_top_logo">
                            <a asp-controller="Home" asp-action="Index">
                                <img src="~/organic-html/assets/images/logo/logo2.png" alt="OrganicaCommerce">
                            </a>
                        </div>
                        <div class="footer_top_social">
                            <ul class="list-unstyled d-flex justify-content-end">
                                <li class="me-3"><a href="#!"><i class="fab fa-twitter"></i></a></li>
                                <li class="me-3"><a href="#!"><i class="fab fa-facebook-f"></i></a></li>
                                <li><a href="#!"><i class="fab fa-youtube"></i></a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="footer_bottom_content text-center py-4">
                        <p class="text-white mb-0">&copy; @DateTime.Now.Year OrganicaCommerce. Tüm hakları saklıdır.</p>
                    </div>
                </div>
            </div>
        </footer>
        <!-- footer section end -->
    </div>

    <script src="~/organic-html/assets/js/jquery.min.js"></script>
    <script src="~/organic-html/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/organic-html/assets/js/aos.js"></script>
    <script src="~/organic-html/assets/js/magnific-popup.min.js"></script>
    <script src="~/organic-html/assets/js/nice-select.min.js"></script>
    <script src="~/organic-html/assets/js/slick.min.js"></script>
    <script src="~/organic-html/assets/js/custom.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
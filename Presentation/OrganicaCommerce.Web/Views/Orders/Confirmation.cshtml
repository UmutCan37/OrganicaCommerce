@model OrganicaCommerce.Contracts.Orders.OrderDetailResponse

@{
    ViewData["Title"] = "Sipariş Onayı";
}

<section class="sec_space_large">
    <div class="container text-center py-5">
        <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
        <h2 class="mt-3">Siparişiniz Alındı!</h2>
        <p class="text-muted">Sipariş numaranız: <strong>#@Model.OrderId.ToString().Substring(0, 8)</strong></p>
        <p class="text-muted">Toplam Tutar: <strong>@Model.Total.ToString("C")</strong></p>

        <div class="mt-4">
            <h5>Sipariş İçeriği</h5>
            <ul class="list-unstyled">
                @foreach (var item in Model.Items)
                {
                    <li>@item.ProductName x @item.Quantity — @((item.UnitPrice * item.Quantity).ToString("C"))</li>
                }
            </ul>
        </div>

        <a asp-controller="Shop" asp-action="List" class="btn custom_btn rounded-pill text-white mt-3">
            Alışverişe Devam Et
        </a>
    </div>
</section>